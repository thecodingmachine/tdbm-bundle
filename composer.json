{
  "name" : "thecodingmachine/tdbm-bundle",
  "description" : "A Symfony bundle for TDBM.",
  "keywords" : [
    "ORM",
    "persistence",
    "DAO",
    "bean",
    "model",
    "TDBM",
    "Symfony",
    "bundle"
  ],
  "homepage" : "https://thecodingmachine.github.io/tdbm",
  "type" : "symfony-bundle",
  "license" : "MIT",
  "authors" : [{
    "name" : "David Négrier",
    "email" : "d.negrier@thecodingmachine.com",
    "homepage" : "http://mouf-php.com"
  }
  ],
  "require" : {
    "php": "^8.0",
    "thecodingmachine/tdbm": "~6.1.0",
    "doctrine/doctrine-bundle": "^2.2.2",
    "doctrine/orm": "^2",
    "symfony/http-kernel": "^5.0 || ^6.0 || ^7.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "symfony/security-bundle": "^5 || ^6 || ^7",
    "symfony/yaml": "^5 || ^6 || ^7",
    "phpunit/phpunit": "^9.5",
    "phpstan/phpstan": "^2.0",
    "thecodingmachine/tdbm-fluid-schema-builder": "^1.0 || ^2.0",
    "symfony/framework-bundle": "^5.1 || ^6 || ^7"
  },
  "scripts": {
    "phpstan": "phpstan analyse TdbmBundle.php DependencyInjection/ Utils/ --level=8 --no-progress"
  },
  "autoload" : {
    "psr-4" : {
      "TheCodingMachine\\TDBM\\Bundle\\" : ""
    }
  },
  "autoload-dev" : {
    "psr-4" : {
      "TheCodingMachine\\TDBM\\Bundle\\" : ""
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "6.0.x-dev"
    }
  }
}
